{
  "name": "@unshared/monorepo",
  "type": "module",
  "version": "0.8.0",
  "license": "MIT",
  "private": true,
  "author": "Stanley Horwood <stanley@hsjm.io>",
  "homepage": "https://github.com/shorwood/unshared#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shorwood/unshared.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ],
    "overrides": {
      "devalue": ">=5.6.4",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "h3": ">=2.0.1-rc.18",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "lodash": ">=4.18.0",
      "defu": ">=6.1.5",
      "ajv": ">=8.18.0",
      "qs": ">=6.14.2",
      "unhead": ">=2.1.11",
      "dompurify": ">=3.3.2",
      "srvx": ">=0.11.13",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "diff@>=6.0.0 <8.0.3": ">=8.0.3",
      "webpack": ">=5.104.1",
      "rollup": ">=4.59.0",
      "serialize-javascript": ">=7.0.5",
      "happy-dom": ">=20.8.9"
    }
  },
  "scripts": {
    "dev": "tsx ./packages/scripts/cli.uncli.ts build --watch true",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsx ./packages/scripts/cli.uncli.ts build --generateIndexes true",
    "lint": "eslint --ignore-pattern examples --concurrency auto",
    "lint:ci": "eslint --cache --ignore-pattern examples",
    "lint:fix": "eslint --fix --cache",
    "test": "vitest --watch",
    "test:run": "vitest run",
    "test:ci": "vitest run --typecheck",
    "test:ui": "vitest --ui",
    "test:types": "vitest --typecheck",
    "test:coverage": "vitest --coverage",
    "commit": "tsx ./packages/scripts/cli.uncli.ts commit",
    "commit:lint": "commitlint --edit",
    "publish:ci": "tsx ./packages/scripts/cli.uncli.ts publish",
    "release": "tsx ./packages/scripts/cli.uncli.ts release"
  },
  "devDependencies": {
    "@commitlint/config-pnpm-scopes": "20.4.3",
    "@types/node": "25.5.2",
    "@unshared/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "4.1.2",
    "@vitest/ui": "4.1.2",
    "@vitest/utils": "4.1.2",
    "commitlint": "20.5.0",
    "eslint": "10.2.0",
    "happy-dom": "20.8.9",
    "husky": "9.1.7",
    "memfs": "4.57.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  }
}
