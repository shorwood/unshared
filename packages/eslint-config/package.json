{
  "name": "@unshared/eslint-config",
  "type": "module",
  "version": "0.8.0",
  "license": "MIT",
  "sideEffects": false,
  "author": "Stanley Horwood <stanley@hsjm.io>",
  "bugs": "https://github.com/shorwood/unshared/issues",
  "homepage": "https://github.com/shorwood/unshared#readme",
  "repository": {
    "directory": "packages/eslint-config",
    "type": "git",
    "url": "git@github.com:shorwood/unshared.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./configs": {
      "require": "./dist/configs.cjs",
      "types": "./dist/configs.d.ts",
      "import": "./dist/configs.js"
    },
    "./utils": {
      "require": "./dist/utils.cjs",
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "peerDependencies": {
    "eslint": ">=9",
    "typescript": ">=5"
  },
  "dependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@unshared/collection": "workspace:*",
    "@unshared/types": "workspace:*",
    "@vitest/eslint-plugin": "1.6.14",
    "eslint-merge-processors": "2.0.0",
    "eslint-plugin-antfu": "3.2.2",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-html": "8.1.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-jsonc": "3.1.2",
    "eslint-plugin-markdown": "5.1.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-perfectionist": "5.8.0",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-sonarjs": "4.0.2",
    "eslint-plugin-unicorn": "64.0.0",
    "eslint-plugin-vue": "10.8.0",
    "eslint-plugin-yml": "3.3.1",
    "eslint-processor-vue-blocks": "2.0.0",
    "jsonc-eslint-parser": "3.1.0",
    "typescript-eslint": "8.58.0",
    "vue-eslint-parser": "10.4.0",
    "yaml-eslint-parser": "2.0.0"
  },
  "devDependencies": {
    "eslint": "10.2.0",
    "typescript": "6.0.2"
  }
}
